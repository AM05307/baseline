

# 감시 종목 (기본: SK하이닉스)
WATCH_KR=000660

# 한국투자증권(KIS) API — 수급(투자자별 매매동향) 전용으로만 필요하다.
# 모의투자 계좌로 발급할 것(CLAUDE.md 보안 원칙 6). 조회 전용 — 이 키로
# 주문(매수/매도)은 호출되지 않는다(collectors/kis_client.py에 주문
# 엔드포인트 자체가 없음).
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT=
KIS_USE_PAPER=true

# SK하이닉스 ADR(SKHY) 전환비율 override. 공식 예탁계약서로 재확인 전까지
# 코드 기본값(10, 1 ADS = 보통주 1/10주)을 쓴다 — analysis/adr.py 참고.
# 비워두면 기본값(10) 사용.
ADR_RATIO=

# OpenDART(전자공시) API — https://opendart.fss.or.kr 에서 무료 발급(가입 즉시).
# 조회 전용(공시/재무제표 조회만, 주문 기능 자체가 없음). 비워두면
# collectors/dart_client.py가 네트워크를 전혀 시도하지 않고 조용히 건너뛴다
# (DART 연동 없이도 기존 기능은 전부 그대로 동작).
DART_API_KEY=

# 에이전트 배치 분석용 (scripts/run_agents.py). https://console.anthropic.com 에서 발급.
# 대시보드/MCP 서버 실행 자체에는 필요 없다 — run_agents.py를 직접 실행할 때만 쓰인다.
ANTHROPIC_API_KEY=
